{
  "name": "react-typescript-mobx-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.21.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "mariadb": "^3.5.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "mobx": "^6.16.1",
    "mobx-react": "^7.6.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node dist/server/server.js",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "npm run prisma:generate && nodemon --watch server --ext ts --exec \"npm run build:server && node dist/server/server.js\"",
    "build": "npm run prisma:generate && npm run build:server && npm run build:client",
    "build:client": "vite build",
    "build:server": "tsc --project server/tsconfig.json",
    "typecheck": "npm run prisma:generate && tsc --noEmit && tsc --project server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  }
}
